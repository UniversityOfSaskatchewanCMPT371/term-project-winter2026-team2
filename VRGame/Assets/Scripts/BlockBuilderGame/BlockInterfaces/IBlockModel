using UnityEngine;

/// <summary>
/// Model portion of the reusable door module. Data is stored here
/// </summary>
/// <remarks>
/// - doorId and targetDoorId, destinationSceneId must be set before calling Init(), targetDoorId must exist.
/// targetSceneId must exist in SceneChangerModel service's path collection
/// </remarks>

public interface IBlockModel
{
    private string id { get; private set; }
    private BlockColour colour;
    private int length { get; private set; }
    private int width { get; private set; }
    public string blockType { get;}
    public Vector3Int gridPosition { get;  set;}
    public Vector3Int targetPosition { get; private set; }
    public bool isPlaced; 
    public bool isGrabbed;
    public bool correctPosition { get; private set; }

     

    /// <summary>
    /// Constructor for the block model
    /// </summary>
    /// <returns>Block object </returns>
    /// <remarks>
    /// Preconditions:
    /// - none
    /// PostConditions:
    /// - A BlockModel instance created
    /// </remarks>
    public BlockModel(string id, BlockColor c, int l, int w)
    {
        BlockModel.id = id;
        colour = c;
        length = l;
        width = w;
        isPlaced = false;
        isGrabbed = false;
    }



    /// <summary>
    /// Determines whether or not block is in the correct postion.
    /// </summary>
    /// <returns> boolean that represents if the block is correctly placed or not </returns>
    /// <remarks>
    /// Preconditions:
    /// - `doorModel` instance var must be non-null and target position must exist.
    /// PostConditions:
    /// - none
    /// </remarks>
    public void IsCorrectlyPlaced(){
        correctPostion = (gridPostion == targetPostion);
        
    }



}